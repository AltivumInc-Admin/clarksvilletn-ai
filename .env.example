# Frontend environment variables (Vite). Copy to .env.local and fill in real values.

# Base URL of the backend HTTP API (SAM HttpApi custom domain).
VITE_API_BASE_URL=https://api.clarksvilletn.ai

# Cognito — from the SAM stack outputs (UserPoolId / UserPoolClientId).
# Required for the authenticated "Add Your Profile" flow; without them the app
# renders a "configuration missing" screen instead of the sign-in form.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=

# Reserved: Cloudflare Turnstile site key. The frontend widget is not yet wired up,
# but the submit-profile Lambda verifies a turnstileToken when TURNSTILE_SECRET is set.
VITE_TURNSTILE_SITE_KEY=
